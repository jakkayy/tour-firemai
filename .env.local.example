NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only secret that lets the scraper refresh the site right after a scrape (POST /api/revalidate).
# Use the same value as the REVALIDATE_SECRET GitHub secret. Never prefix it with NEXT_PUBLIC_.
REVALIDATE_SECRET=
# Optional: LINE Official Account "add friend" link. The banner and footer button stay hidden when unset.
NEXT_PUBLIC_LINE_ADD_FRIEND_URL=
